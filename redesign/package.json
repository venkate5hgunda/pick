{
  "name": "pick-redesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test checks/inventory.check.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "format": "prettier --write src checks scripts *.ts *.json",
    "check:format": "prettier --check src checks scripts *.ts *.json",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
